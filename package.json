{
  "name": "semver-action",
  "version": "1.0.0",
  "description": "Validate a strict semantic version with an optional v prefix.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && ncc build src/index.ts -o dist --minify",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test test/*.test.mts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "github-actions",
    "semver",
    "version"
  ],
  "author": "insd47",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.7.1",
    "@vercel/ncc": "^0.45.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
